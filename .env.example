# FTP Agent Configuration
# Copy to .env and fill in values
# These override appsettings.json values via FTPAGENT_ prefix

# GitHub
FTPAGENT_GitHub__Repository=org/repo-name
FTPAGENT_GitHub__TargetRepoPath=/path/to/target/repo
FTPAGENT_GitHub__WorkflowName=build-and-deploy

# Octopus Deploy
FTPAGENT_OctopusDeploy__ServerUrl=https://octopus.company.com
FTPAGENT_OctopusDeploy__ApiKey=API-XXXXXXXXXXXX
FTPAGENT_OctopusDeploy__ProjectName=File-Ingestion
FTPAGENT_OctopusDeploy__EnvironmentName=Production

# Datadog
FTPAGENT_Datadog__ApiKey=your-dd-api-key
FTPAGENT_Datadog__AppKey=your-dd-app-key
FTPAGENT_Datadog__ServiceName=file-ingestion
FTPAGENT_Datadog__Environment=production

# Agent
FTPAGENT_Agent__LegacyConfigSourcePath=/path/to/legacy-configs.csv
FTPAGENT_Agent__BatchSize=10
FTPAGENT_Agent__MaxRetriesPerFile=3
