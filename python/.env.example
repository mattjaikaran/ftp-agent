# FTP Agent Configuration
# Copy to .env and fill in values
# These override settings.toml via FTPAGENT_ prefix

# LLM Provider (minimax | anthropic | openai-compat | ollama)
FTPAGENT_LLM__PROVIDER=minimax

# MiniMax M2.5
FTPAGENT_LLM__MINIMAX__API_KEY=sk-...

# Anthropic Claude (optional)
FTPAGENT_LLM__ANTHROPIC__API_KEY=sk-ant-...

# OpenAI-Compatible (optional)
FTPAGENT_LLM__OPENAI_COMPAT__API_KEY=sk-...
FTPAGENT_LLM__OPENAI_COMPAT__BASE_URL=https://api.openai.com/v1

# Ollama (optional)
FTPAGENT_LLM__OLLAMA__BASE_URL=http://localhost:11434

# GitHub
FTPAGENT_GITHUB__REPOSITORY=org/repo-name
FTPAGENT_GITHUB__TARGET_REPO_PATH=/path/to/target/repo
FTPAGENT_GITHUB__WORKFLOW_NAME=build-and-deploy

# Octopus Deploy
FTPAGENT_DEPLOYMENT__PROVIDER=stub
FTPAGENT_DEPLOYMENT__OCTOPUS__SERVER_URL=https://octopus.company.com
FTPAGENT_DEPLOYMENT__OCTOPUS__API_KEY=API-XXXXXXXXXXXX
FTPAGENT_DEPLOYMENT__OCTOPUS__PROJECT_NAME=File-Ingestion
FTPAGENT_DEPLOYMENT__OCTOPUS__ENVIRONMENT_NAME=Production

# Datadog
FTPAGENT_MONITORING__PROVIDER=stub
FTPAGENT_MONITORING__DATADOG__API_KEY=your-dd-api-key
FTPAGENT_MONITORING__DATADOG__APP_KEY=your-dd-app-key
FTPAGENT_MONITORING__DATADOG__SERVICE_NAME=file-ingestion
FTPAGENT_MONITORING__DATADOG__ENVIRONMENT=production

# API Key (empty = no auth required)
FTPAGENT_API_KEY=

# CORS origins (comma-separated, default: *)
FTPAGENT_CORS_ORIGINS=*

# Agent
FTPAGENT_AGENT__LEGACY_CONFIG_SOURCE_PATH=/path/to/legacy-configs.csv
FTPAGENT_AGENT__SCHEDULE_INTERVAL_HOURS=0
FTPAGENT_AGENT__BATCH_SIZE=10
FTPAGENT_AGENT__STATE_DATABASE_PATH=/data/migration-state.db
